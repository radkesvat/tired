{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical service review evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "approved_sha256", "argument_count", "acknowledged_risks", "sensitive_arguments"],
  "properties": {
    "schema_version": {"const": 1},
    "approved_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "argument_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "acknowledged_risks": {
      "type": "array", "maxItems": 7, "uniqueItems": true,
      "items": {"enum": ["run-as-root", "privileged-capabilities", "writable-privileged-code", "rapid-persistent-retry", "sensitive-command-data", "restore-drifted-unit", "sensitive-export"]}
    },
    "sensitive_arguments": {
      "type": "array", "maxItems": 4095, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 4095}
    }
  }
}
